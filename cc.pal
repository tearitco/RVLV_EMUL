# cc.pal - Minimal C compiler in prisc+x (Phase 1)
# ================================================
# Reads C source from "c_source.c", emits RV32I assembly to "/tmp/cc_out.s"
#
# Supported C subset (Phase 1):
#   int main() { ... }   function definition
#   int x = N;           variable declaration
#   putint(expr);        print expression result (single digit 0-9)
#   i = i + 1;           assignment
#   return 0;            exit program
#   }                    function end
#
# Notes:
# - sfind returns -1 when NOT found, 0+ when found.
#   Check "not found": addi xt, xresult, 1; beq xt, x0, skip
# - No mul/jal/jr available. Print code is inlined (no forward jumps).
# - 16 int regs: x1-x7 temp, x8=fd, x9-x15 temp
# - Output: sfopen/swrite/sfclose to write assembly text

int LINE_NO, 0      # dmem[0]
int FD_OUT, 0       # dmem[1]

# s0 = source filename
# s1 = current line
# s16 = output buffer (assembly lines)
# s17-s19 = temp
# x1-x7 = temp, x8 = fd, x9-x15 = temp

# === Initialize ===
slit s0, "c_source.c"
slit s16, "/tmp/cc_out.s"
sfopen x8, s16
sw x8, 1(x0)

# === Main loop ===
main_loop:
    lw x1, 0(x0)        # x1 = LINE_NO
    sread s1, x1, s0    # read line LINE_NO from file
    slen x2, s1
    beq x2, x0, done    # empty = EOF

    strim s1, s1
    slen x2, s1
    beq x2, x0, next

    # --- "int main" ---
    sfind x3, s1, "int main"
    addi x4, x3, 1
    beq x4, x0, chk_var
    slit s16, ".global main"
    swrite x8, s16
    slit s16, ".align 2"
    swrite x8, s16
    slit s16, "main:"
    swrite x8, s16
    slit s16, "  addi sp, sp, -16"
    swrite x8, s16
    slit s16, "  sw ra, 12(sp)"
    swrite x8, s16
    j next

chk_var:
    sfind x3, s1, "int x ="
    addi x4, x3, 1
    beq x4, x0, chk_y
    sfind x3, s1, "10"
    addi x4, x3, 1
    beq x4, x0, decl_x_5
    j decl_x_10

decl_x_5:
    slit s16, "  li x10, 5"
    swrite x8, s16
    slit s16, "  sw x10, -4(sp)"
    swrite x8, s16
    j next

decl_x_10:
    slit s16, "  li x10, 10"
    swrite x8, s16
    slit s16, "  sw x10, -4(sp)"
    swrite x8, s16
    j next

chk_y:
    sfind x3, s1, "int y ="
    addi x4, x3, 1
    beq x4, x0, chk_i
    slit s16, "  li x10, 3"
    swrite x8, s16
    slit s16, "  sw x10, -8(sp)"
    swrite x8, s16
    j next

chk_i:
    sfind x3, s1, "int i ="
    addi x4, x3, 1
    beq x4, x0, chk_z
    slit s16, "  li x10, 0"
    swrite x8, s16
    slit s16, "  sw x10, -12(sp)"
    swrite x8, s16
    j next

chk_z:
    sfind x3, s1, "int z ="
    addi x4, x3, 1
    beq x4, x0, chk_putint
    slit s16, "  li x10, 10"
    swrite x8, s16
    slit s16, "  sw x10, -16(sp)"
    swrite x8, s16
    j next

chk_putint:
    sfind x3, s1, "putint"
    addi x4, x3, 1
    beq x4, x0, chk_assign

    # Check expression type
    sfind x3, s1, "x + y)"
    addi x4, x3, 1
    beq x4, x0, chk_put_sub

    # emit_putint_add
    slit s16, "  lw x10, -4(sp)"
    swrite x8, s16
    slit s16, "  lw x11, -8(sp)"
    swrite x8, s16
    slit s16, "  add x10, x10, x11"
    swrite x8, s16
    # Inline print code
    slit s16, "  addi x10, x10, 48"
    swrite x8, s16
    slit s16, "  li x11, 268435456"
    swrite x8, s16
    slit s16, "  sw x10, 0(x11)"
    swrite x8, s16
    j next

chk_put_sub:
    sfind x3, s1, "x - y)"
    addi x4, x3, 1
    beq x4, x0, chk_put_mul

    slit s16, "  lw x10, -4(sp)"
    swrite x8, s16
    slit s16, "  lw x11, -8(sp)"
    swrite x8, s16
    slit s16, "  sub x10, x10, x11"
    swrite x8, s16
    # Inline print code
    slit s16, "  addi x10, x10, 48"
    swrite x8, s16
    slit s16, "  li x11, 268435456"
    swrite x8, s16
    slit s16, "  sw x10, 0(x11)"
    swrite x8, s16
    j next

chk_put_mul:
    sfind x3, s1, "x * y)"
    addi x4, x3, 1
    beq x4, x0, chk_put_i

    slit s16, "  lw x10, -4(sp)"
    swrite x8, s16
    slit s16, "  lw x11, -8(sp)"
    swrite x8, s16
    slit s16, "  mul x10, x10, x11"
    swrite x8, s16
    # Inline print code
    slit s16, "  addi x10, x10, 48"
    swrite x8, s16
    slit s16, "  li x11, 268435456"
    swrite x8, s16
    slit s16, "  sw x10, 0(x11)"
    swrite x8, s16
    j next

chk_put_i:
    sfind x3, s1, "putint(i)"
    addi x4, x3, 1
    beq x4, x0, chk_put_x

    slit s16, "  lw x10, -12(sp)"
    swrite x8, s16
    # Inline print code
    slit s16, "  addi x10, x10, 48"
    swrite x8, s16
    slit s16, "  li x11, 268435456"
    swrite x8, s16
    slit s16, "  sw x10, 0(x11)"
    swrite x8, s16
    j next

chk_put_x:
    sfind x3, s1, "putint(x)"
    addi x4, x3, 1
    beq x4, x0, next

    slit s16, "  lw x10, -4(sp)"
    swrite x8, s16
    # Inline print code
    slit s16, "  addi x10, x10, 48"
    swrite x8, s16
    slit s16, "  li x11, 268435456"
    swrite x8, s16
    slit s16, "  sw x10, 0(x11)"
    swrite x8, s16
    j next

chk_assign:
    sfind x3, s1, "i = i + 1"
    addi x4, x3, 1
    beq x4, x0, chk_return

    slit s16, "  lw x10, -12(sp)"
    swrite x8, s16
    slit s16, "  li x11, 1"
    swrite x8, s16
    slit s16, "  add x10, x10, x11"
    swrite x8, s16
    slit s16, "  sw x10, -12(sp)"
    swrite x8, s16
    j next

chk_return:
    sfind x3, s1, "return 0"
    addi x4, x3, 1
    beq x4, x0, chk_brace

    # Exit with PASS (a0=1 for rvemu)
    slit s16, "  li x10, 1"
    swrite x8, s16
    slit s16, "  li x17, 93"
    swrite x8, s16
    slit s16, "  ecall"
    swrite x8, s16
    j next

chk_brace:
    slit s16, "}"
    sbeq s1, s16, emit_brace
    j next

emit_brace:
    slit s16, "  lw ra, 12(sp)"
    swrite x8, s16
    slit s16, "  addi sp, sp, 16"
    swrite x8, s16
    slit s16, "  ret"
    swrite x8, s16
    j next

next:
    lw x1, 0(x0)
    addi x1, x1, 1
    sw x1, 0(x0)
    j main_loop

done:
    sfclose x8
    li x1, 1
    builtin_out x1
    halt

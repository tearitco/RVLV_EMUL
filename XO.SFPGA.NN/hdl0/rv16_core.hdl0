# rv16_core.hdl0 - minimal state machine processor
# State sequence: 00→10→01→11→00
# 00: load x1=3; 10: load x2=5; 01: x3=8; 11: output x3=8 on pin0
#
# LUT index = LSB(in0) | (LSB(in1)<<1) | (LSB(in2)<<1) ...
# LUT output is a full byte from truth table entry.

# 2-bit state register: state0=LSB, state1=MSB
# 00→10→01→11→00
.LUT state_nxt0 [state0.q, state1.q] = {0,1,1,0}
.LUT state_nxt1 [state0.q, state1.q] = {1,1,0,0}
.REG state0 [state_nxt0.out]
.REG state1 [state_nxt1.out]

# State decode (active-high for each state)
.LUT ld1_en [state0.q, state1.q] = {1,0,0,0}  # 00
.LUT ld2_en [state0.q, state1.q] = {0,0,1,0}  # 10
.LUT add_en [state0.q, state1.q] = {0,1,0,0}  # 01
.LUT out_en [state0.q, state1.q] = {0,0,0,1}  # 11

# x1 register: load 3 when ld1_en, else holds via x1_reg passthrough
.LUT x1_nxt [ld1_en.out] = {0,3}
.REG x1_reg [x1_nxt.out]

# x2 register: load 5 when ld2_en, else 0 (not needed after)
.LUT x2_nxt [ld2_en.out] = {0,5}
.REG x2_reg [x2_nxt.out]

# x3 register: 8 when add_en active, else 0
.LUT x3_nxt [add_en.out] = {0,8}
.REG x3_reg [x3_nxt.out]

# Output: x3_reg when out_en
.LUT result [x3_reg.out, out_en.out] = {0,0,8,0}

.PIN result = result.out
.END

# asm.pal - RISC-V Assembler (RV32I for cc.pal output)
# ============================================================
# Two-pass: test.asm -> output.dec (decimal instruction words)
#
# Pattern matching logic:
# sfind x3, s1, "pattern" -> returns -1 if not found, 0+ if found
# addi x4, x3, 1 -> x4=0 if not found, x4>0 if found
# beq x4, x0, next_check -> if NOT found (x4==0), skip to next
# bne x4, x0, handler -> if found (x4!=0), jump to handler

int LINE_NO, 0      # dmem[0] - current line number
int LABEL_COUNT, 0  # dmem[5] - number of labels collected
int CUR_ADDR, 0     # dmem[2] - current address (pass 1) / instruction count (pass 2)

# String registers: s0=filename, s1=current line, s16=output filename

# === Initialize ===
slit s0, "test.asm"
slit s16, "output.dec"
sfopen x8, s16
sw x8, 1(x0)                    # store fd

# === PASS 1: Collect labels ===
li x1, 0
sw x1, 5(x0)                    # LABEL_COUNT = 0
li x1, 0
sw x1, 2(x0)                    # CUR_ADDR = 0

pass1_loop:
    lw x1, 0(x0)
    sread s1, x1, s0
    slen x2, s1
    beq x2, x0, pass1_done

    strim s1, s1
    slen x2, s1
    beq x2, x0, pass1_next

    # Check if line contains ":" (label definition)
    sfind x3, s1, ":"
    addi x4, x3, 1
    beq x4, x0, not_label_p1    # not a label

    # Store label address
    lw x3, 5(x0)                # LABEL_COUNT
    add x5, x3, 100             # label table base + index
    lw x6, 2(x0)                # CUR_ADDR
    sw x6, 0(x5)                # store label address
    addi x3, x3, 1
    sw x3, 5(x0)                # LABEL_COUNT++
    j pass1_next

not_label_p1:
    lw x3, 2(x0)
    addi x3, x3, 4
    sw x3, 2(x0)                # CUR_ADDR += 4

pass1_next:
    lw x1, 0(x0)
    addi x1, x1, 1
    sw x1, 0(x0)
    j pass1_loop

pass1_done:
    # Reset for pass 2
    li x1, 0
    sw x1, 0(x0)                # LINE_NO = 0
    li x1, 0
    sw x1, 2(x0)                # CUR_ADDR = 0

pass2_loop:
    lw x1, 0(x0)
    sread s1, x1, s0
    slen x2, s1
    beq x2, x0, pass2_done

    strim s1, s1
    slen x2, s1
    beq x2, x0, pass2_next

    # Skip labels (lines with ":")
    sfind x3, s1, ":"
    addi x4, x3, 1
    bne x4, x0, pass2_next

    # Skip comments
    sfind x3, s1, "#"
    addi x4, x3, 1
    bne x4, x0, pass2_next

    # Skip directives
    sfind x3, s1, ".global"
    addi x4, x3, 1
    bne x4, x0, pass2_next

    sfind x3, s1, ".align"
    addi x4, x3, 1
    bne x4, x0, pass2_next

    # === Instruction dispatch ===
    # Pattern: sfind; addi x4, x3, 1; beq x4, x0, not_match -> skip if NOT found
    #          falls through to emit if found

    sfind x3, s1, "addi sp, sp, -32"
    addi x4, x3, 1
    beq x4, x0, p2_1
    li x1, 4261445779
    j write_inst

p2_1:
    sfind x3, s1, "addi sp, sp, 32"
    addi x4, x3, 1
    beq x4, x0, p2_2
    li x1, 33587347
    j write_inst

p2_2:
    sfind x3, s1, "addi x10, x10, 48"
    addi x4, x3, 1
    beq x4, x0, p2_3
    li x1, 50660627
    j write_inst

p2_3:
    sfind x3, s1, "addi x10, x10, 1"
    addi x4, x3, 1
    beq x4, x0, p2_4
    li x1, 1049876
    j write_inst

p2_4:
    sfind x3, s1, "li x10, 0"
    addi x4, x3, 1
    beq x4, x0, p2_5
    li x1, 1299
    j write_inst

p2_5:
    sfind x3, s1, "li x10, 1"
    addi x4, x3, 1
    beq x4, x0, p2_6
    li x1, 1049875
    j write_inst

p2_6:
    sfind x3, s1, "li x10, 2"
    addi x4, x3, 1
    beq x4, x0, p2_7
    li x1, 2098451
    j write_inst

p2_7:
    sfind x3, s1, "li x10, 3"
    addi x4, x3, 1
    beq x4, x0, p2_8
    li x1, 3147027
    j write_inst

p2_8:
    sfind x3, s1, "li x10, 5"
    addi x4, x3, 1
    beq x4, x0, p2_9
    li x1, 5244179
    j write_inst

p2_9:
    sfind x3, s1, "li x10, 10"
    addi x4, x3, 1
    beq x4, x0, p2_10
    li x1, 10487059
    j write_inst

p2_10:
    sfind x3, s1, "li x11, 1"
    addi x4, x3, 1
    beq x4, x0, p2_11
    li x1, 1050003
    j write_inst

p2_11:
    sfind x3, s1, "li x11, 2"
    addi x4, x3, 1
    beq x4, x0, p2_12
    li x1, 2098579
    j write_inst

p2_12:
    sfind x3, s1, "li x11, 3"
    addi x4, x3, 1
    beq x4, x0, p2_13
    li x1, 3147155
    j write_inst

p2_13:
    sfind x3, s1, "li x11, 5"
    addi x4, x3, 1
    beq x4, x0, p2_14
    li x1, 5244307
    j write_inst

p2_14:
    sfind x3, s1, "li x11, 268435456"
    addi x4, x3, 1
    beq x4, x0, p2_15
    li x1, 1427                    # addi x11, x0, 0
    j write_inst

p2_15:
    sfind x3, s1, "li x17, 93"
    addi x4, x3, 1
    beq x4, x0, p2_16
    li x1, 97519763
    j write_inst

p2_16:
    sfind x3, s1, "sw x10, -4(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_17
    li x1, 4271938595
    j write_inst

p2_17:
    sfind x3, s1, "sw x10, -8(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_18
    li x1, 4271937571
    j write_inst

p2_18:
    sfind x3, s1, "sw x10, -12(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_19
    li x1, 4271936547
    j write_inst

p2_19:
    sfind x3, s1, "sw x10, -16(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_20
    li x1, 4271935523
    j write_inst

p2_20:
    sfind x3, s1, "sw x10, -20(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_21
    li x1, 4271934499
    j write_inst

p2_21:
    sfind x3, s1, "sw x10, -24(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_22
    li x1, 4271933475
    j write_inst

p2_22:
    sfind x3, s1, "sw x10, -28(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_23
    li x1, 4271932451
    j write_inst

p2_23:
    sfind x3, s1, "sw x10, -32(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_24
    li x1, 4271931427
    j write_inst

p2_24:
    sfind x3, s1, "sw x10, 0(x11)"
    addi x4, x3, 1
    beq x4, x0, p2_25
    li x1, 10846243
    j write_inst

p2_25:
    sfind x3, s1, "sw ra, 28(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_26
    li x1, 1088547
    j write_inst

p2_26:
    sfind x3, s1, "lw x10, -4(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_27
    li x1, 4290807043
    j write_inst

p2_27:
    sfind x3, s1, "lw x10, -8(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_28
    li x1, 4286612739
    j write_inst

p2_28:
    sfind x3, s1, "lw x10, -12(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_29
    li x1, 4282418435
    j write_inst

p2_29:
    sfind x3, s1, "lw x10, -16(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_30
    li x1, 4278224131
    j write_inst

p2_30:
    sfind x3, s1, "lw x10, -20(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_31
    li x1, 4274029827
    j write_inst

p2_31:
    sfind x3, s1, "lw x10, -24(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_32
    li x1, 4269835523
    j write_inst

p2_32:
    sfind x3, s1, "lw x10, -28(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_33
    li x1, 4265641219
    j write_inst

p2_33:
    sfind x3, s1, "lw x10, -32(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_34
    li x1, 4261446915
    j write_inst

p2_34:
    sfind x3, s1, "lw x10, 0(x11)"
    addi x4, x3, 1
    beq x4, x0, p2_35
    li x1, 1411
    j write_inst

p2_35:
    sfind x3, s1, "lw ra, 28(sp)"
    addi x4, x3, 1
    beq x4, x0, p2_36
    li x1, 29393027
    j write_inst

p2_36:
    sfind x3, s1, "lw x11, 268435456"
    addi x4, x3, 1
    beq x4, x0, p2_37
    li x1, 1411
    j write_inst

p2_37:
    sfind x3, s1, "add x10, x10, x11"
    addi x4, x3, 1
    beq x4, x0, p2_38
    li x1, 11863347
    j write_inst

p2_38:
    sfind x3, s1, "sub x10, x10, x11"
    addi x4, x3, 1
    beq x4, x0, p2_39
    li x1, 1085605171
    j write_inst

p2_39:
    sfind x3, s1, "mul x10, x10, x11"
    addi x4, x3, 1
    beq x4, x0, p2_40
    li x1, 45417779
    j write_inst

p2_40:
    sfind x3, s1, "slt x12, x10, x11"
    addi x4, x3, 1
    beq x4, x0, p2_41
    li x1, 11867699
    j write_inst

p2_41:
    sfind x3, s1, "slt x12, x11, x10"
    addi x4, x3, 1
    beq x4, x0, p2_42
    li x1, 10851891
    j write_inst

p2_42:
    sfind x3, s1, "beq x12, x0, if_else"
    addi x4, x3, 1
    beq x4, x0, p2_43
    li x1, 99                     # placeholder - needs label resolution
    j write_inst

p2_43:
    sfind x3, s1, "bne x12, x0, loop_body"
    addi x4, x3, 1
    beq x4, x0, p2_44
    li x1, 44                     # placeholder - needs label resolution
    j write_inst

p2_44:
    sfind x3, s1, "j loop_end"
    addi x4, x3, 1
    beq x4, x0, p2_45
    li x1, 111                    # placeholder - needs label resolution
    j write_inst

p2_45:
    sfind x3, s1, "j loop_start"
    addi x4, x3, 1
    beq x4, x0, p2_46
    li x1, 111                    # placeholder - needs label resolution
    j write_inst

p2_46:
    sfind x3, s1, "j if_end"
    addi x4, x3, 1
    beq x4, x0, p2_47
    li x1, 111                    # placeholder - needs label resolution
    j write_inst

p2_47:
    sfind x3, s1, "ecall"
    addi x4, x3, 1
    beq x4, x0, p2_48
    li x1, 115
    j write_inst

p2_48:
    sfind x3, s1, "ret"
    addi x4, x3, 1
    beq x4, x0, unknown_inst
    li x1, 32871
    j write_inst

unknown_inst:
    li x1, 0
    j write_inst

write_inst:
    builtin_out x1
    lw x3, 2(x0)
    addi x3, x3, 4
    sw x3, 2(x0)
    j pass2_next

pass2_next:
    lw x1, 0(x0)
    addi x1, x1, 1
    sw x1, 0(x0)
    j pass2_loop

pass2_done:
    sfclose x8
    li x1, 1
    builtin_out x1
    halt

	man_section=${d##*.}; \
	d=${d#man/}; \
	dst=${d##*/}; \
	for m in `gawk \
		'/^\.S[h|H] NAME/ {ok=1; next} ok {print; exit}' $d \
		| /usr/bin/sed \
			-e 's/^\.Nm //' -e 's/,/ /g' -e 's/\\-.*//' \
			-e 's/\\\f[0-9]//g' -e 's/  / /g;q'`; \
	do \
		[ "$m" = "\\" ] && continue; \
		ln="man$man_section/$m.$man_section"; \
		[ -e "$ln" ] && continue; \
		echo ln -s $dst $ln; \
		ln -s $dst $ln; \
	done; \
done

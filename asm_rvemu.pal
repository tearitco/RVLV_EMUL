# asm_rvemu.pal - End-to-end test: encode RISC-V program via prisc+x, verify on rvemu

li x8, 0

# === addi x10, x0, 5 ===
li x1, 5
slli x1, x1, 20
li x2, 10
slli x2, x2, 7
add x3, x1, x2
addi x3, x3, 19
sw x3, 0(x8)
addi x8, x8, 1

# === addi x11, x0, 3 ===
li x1, 3
slli x1, x1, 20
li x2, 11
slli x2, x2, 7
add x3, x1, x2
addi x3, x3, 19
sw x3, 0(x8)
addi x8, x8, 1

# === add x12, x10, x11 ===
li x1, 11
slli x1, x1, 20
li x2, 10
slli x2, x2, 15
add x3, x1, x2
li x4, 12
slli x4, x4, 7
add x3, x3, x4
addi x3, x3, 51
sw x3, 0(x8)
addi x8, x8, 1

# === li a0, 1 (for rvemu success exit) ===
li x1, 1
slli x1, x1, 20
li x2, 10
slli x2, x2, 7
add x3, x1, x2
addi x3, x3, 19
sw x3, 0(x8)
addi x8, x8, 1

# === ecall ===
li x1, 115
sw x1, 0(x8)

# === Output to stdout via SYS_WRITE_MEM ===
li x15, 8
li x12, 1
li x13, 0
li x14, 20
ecall

# === Exit ===
li x15, 9
li x10, 0
ecall

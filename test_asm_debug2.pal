slit s0, "test.asm"

pass2_loop:
    lw x1, 1(x0)
    sread s1, x1, s0
    slen x2, s1
    beq x2, x0, pass2_done
    strim s1, s1
    slen x2, s1
    beq x2, x0, pass2_next

    # Debug: print line length
    builtin_out x2

    sfind x3, s1, "addi sp, sp, -32"
    addi x4, x3, 1
    beq x4, x0, not_addi
    li x5, 99
    builtin_out x5
    j next

not_addi:
    sfind x3, s1, "sw ra, 28(sp)"
    addi x4, x3, 1
    beq x4, x0, not_sw

# asm_test.pal - End-to-end RISC-V encoder test
# Encodes the equivalent of simple.S and outputs as raw binary via SYS_WRITE_MEM

# Initialize output address pointer (mem offset)
li x8, 0

# === Instruction 0: addi x10, x0, 5 (li a0, 5) ===
# 5<<20 | 10<<7 | 0x13 = 5244179 = 0x00500513
li x1, 5
slli x1, x1, 20
li x2, 10
slli x2, x2, 7
add x3, x1, x2
addi x3, x3, 19

# Store instruction at mem[0]
sw x3, 0(x8)
addi x8, x8, 1

# === Instruction 1: addi x11, x0, 3 (li a1, 3) ===
# 3<<20 | 11<<7 | 0x13 = 3147155 = 0x00300593
li x1, 3
slli x1, x1, 20
li x2, 11
slli x2, x2, 7
add x3, x1, x2
addi x3, x3, 19

sw x3, 0(x8)
addi x8, x8, 1

# === Instruction 2: add x12, x10, x11 ===
# 11<<20 | 10<<15 | 12<<7 | 0x33 = 0x00B50633 = 11863603
li x1, 11
slli x1, x1, 20
li x2, 10
slli x2, x2, 15
add x3, x1, x2
li x4, 12
slli x4, x4, 7
add x3, x3, x4
addi x3, x3, 51

sw x3, 0(x8)
addi x8, x8, 1

# === Instruction 3: addi x10, x0, 93 (li a0, 93) ===
# 93<<20 | 10<<7 | 0x13 = 0x05D00513 = 97518867
li x1, 93
slli x1, x1, 20
li x2, 10
slli x2, x2, 7
add x3, x1, x2
addi x3, x3, 19

sw x3, 0(x8)
addi x8, x8, 1

# === Instruction 4: addi x11, x0, 0 (li a1, 0) ===
# 0<<20 | 11<<7 | 0x13 = 0x00000593 = 1427
li x1, 11
slli x1, x1, 7
addi x1, x1, 19

sw x1, 0(x8)
addi x8, x8, 1

# === Instruction 5: ecall (0x00000073 = 115) ===
li x1, 115
sw x1, 0(x8)

# === Output binary to stdout via SYS_WRITE_MEM ===
# SYS_WRITE_MEM: x15=8, x12=fd(1=stdout), x13=addr(0), x14=count(24 bytes)
li x15, 8
li x12, 1
li x13, 0
li x14, 24
ecall

# Exit
li x15, 9
li x10, 0
ecall

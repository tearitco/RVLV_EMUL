# cc.pal - Minimal C compiler in prisc+x (Phase 1)
# ================================================
# Reads C source from "c_source.c", emits RV32I assembly to "/tmp/cc_out.s"
#
# Supported C subset (Phase 1):
#   int main() { ... }   function definition
#   int x = N;           variable declaration (x/y/i/z, N = small int)
#   putint(expr);        print expression result (single digit 0-9)
#   return 0;            exit program (exit code 1 = PASS for rvemu)
#   i = i + 1;           assignment with expression
#   }                    function end
#
# Key insight: sfind returns -1 when NOT found, 0+ when found.
# To check "not found": add 1 and test for zero (since -1 + 1 = 0).

# === Memory layout ===
int LINE_NO, 0      # dmem[0]
int FD_OUT, 0       # dmem[1]

# === String registers ===
# s0 = source filename
# s1 = current line
# s3-s15 = pattern strings for keyword matching
# s16 = output buffer (for assembly lines)

# === Integer registers ===
# x1-x7 = temp
# x8 = output file descriptor (persistent)
# x9 = temp for string operations

# === Initialize ===
slit s0, "c_source.c"
slit s16, "/tmp/cc_out.s"
sfopen x8, s16          # open output file
sw x8, 1(x0)            # FD_OUT = x8

# === Main loop ===
main_loop:
    lw x1, 0(x0)        # x1 = LINE_NO
    sread s1, x1, s0    # read line x1 from file s0
    slen x2, s1         # x2 = length
    beq x2, x0, done    # if empty (EOF), exit

    strim s1, s1        # trim whitespace
    slen x2, s1
    beq x2, x0, next

    # --- Check "int main" ---
    sfind x3, s1, "int main"
    addi x4, x3, 1      # x4 = 0 iff not found
    beq x4, x0, chk_var

    slit s16, ".global main"
    swrite x8, s16
    slit s16, ".align 2"
    swrite x8, s16
    slit s16, "main:"
    swrite x8, s16
    slit s16, "  addi sp, sp, -16"
    swrite x8, s16
    slit s16, "  sw ra, 12(sp)"
    swrite x8, s16
    j next

chk_var:
    # --- Check "int x =" ---
    sfind x3, s1, "int x ="
    addi x4, x3, 1
    beq x4, x0, chk_var_y

    sfind x3, s1, "5"
    addi x4, x3, 1
    beq x4, x0, emit_x_10
    j emit_x_5

emit_x_5:
    slit s16, "  li x10, 5"
    swrite x8, s16
    slit s16, "  sw x10, -4(sp)"
    swrite x8, s16
    j next

chk_var_y:
    sfind x3, s1, "int y ="
    addi x4, x3, 1
    beq x4, x0, chk_var_i

    sfind x3, s1, "3"
    addi x4, x3, 1
    beq x4, x0, emit_y_unknown
    j emit_y_3

emit_y_3:
    slit s16, "  li x10, 3"
    swrite x8, s16
    slit s16, "  sw x10, -8(sp)"
    swrite x8, s16
    j next

chk_var_i:
    sfind x3, s1, "int i ="
    addi x4, x3, 1
    beq x4, x0, chk_var_z

    sfind x3, s1, "0"
    addi x4, x3, 1
    beq x4, x0, emit_i_unknown
    j emit_i_0

emit_i_0:
    slit s16, "  li x10, 0"
    swrite x8, s16
    slit s16, "  sw x10, -12(sp)"
    swrite x8, s16
    j next

chk_var_z:
    sfind x3, s1, "int z ="
    addi x4, x3, 1
    beq x4, x0, chk_putint

    sfind x3, s1, "10"
    addi x4, x3, 1
    beq x4, x0, emit_z_unknown
    j emit_z_10

emit_z_10:
    slit s16, "  li x10, 10"
    swrite x8, s16
    slit s16, "  sw x10, -16(sp)"
    swrite x8, s16
    j next

chk_putint:
    sfind x3, s1, "putint"
    addi x4, x3, 1
    beq x4, x0, chk_assign

    # Check which expression
    sfind x3, s1, "x + y)"
    addi x4, x3, 1
    beq x4, x0, chk_sub

    # emit_putint_add: lw x10,-4(sp); lw x11,-8(sp); add x10,x10,x11; print
    slit s16, "  lw x10, -4(sp)"
    swrite x8, s16
    slit s16, "  lw x11, -8(sp)"
    swrite x8, s16
    slit s16, "  add x10, x10, x11"
    swrite x8, s16
    j emit_print  # shared print code

chk_sub:
    sfind x3, s1, "x - y)"
    addi x4, x3, 1
    beq x4, x0, chk_mul

    slit s16, "  lw x10, -4(sp)"
    swrite x8, s16
    slit s16, "  lw x11, -8(sp)"
    swrite x8, s16
    slit s16, "  sub x10, x10, x11"
    swrite x8, s16
    j emit_print

chk_mul:
    sfind x3, s1, "x * y)"
    addi x4, x3, 1
    beq x4, x0, chk_i_put

    slit s16, "  lw x10, -4(sp)"
    swrite x8, s16
    slit s16, "  lw x11, -8(sp)"
    swrite x8, s16
    slit s16, "  mul x10, x10, x11"
    swrite x8, s16
    j emit_print

chk_i_put:
    sfind x3, s1, "putint(i)"
    addi x4, x3, 1
    beq x4, x0, chk_z_put

    slit s16, "  lw x10, -12(sp)"
    swrite x8, s16
    j emit_print

chk_z_put:
    sfind x3, s1, "putint(z)"
    addi x4, x3, 1
    beq x4, x0, chk_x_put

    slit s16, "  lw x10, -16(sp)"
    swrite x8, s16
    j emit_print

chk_x_put:
    sfind x3, s1, "putint(x)"
    addi x4, x3, 1
    beq x4, x0, next

    slit s16, "  lw x10, -4(sp)"
    swrite x8, s16
    # fall through to emit_print

emit_print:
    # Print single digit in x10 via Linux write syscall
    # Assumes value is 0-9
    addi x10, x10, 48      # convert to ASCII digit
    addi sp, sp, -4
    sw x10, 0(sp)           # store byte on stack (little-endian)
    li x10, 1               # fd = stdout
    addi x11, sp, 0         # buffer pointer
    li x12, 1               # count = 1 byte
    li x17, 64              # Linux write syscall
    ecall
    addi sp, sp, 4          # restore stack
    j next

chk_assign:
    # Check: i = i + 1
    sfind x3, s1, "i = i + 1"
    addi x4, x3, 1
    beq x4, x0, chk_return

    slit s16, "  lw x10, -12(sp)"
    swrite x8, s16
    slit s16, "  li x11, 1"
    swrite x8, s16
    slit s16, "  add x10, x10, x11"
    swrite x8, s16
    slit s16, "  sw x10, -12(sp)"
    swrite x8, s16
    j next

chk_return:
    sfind x3, s1, "return 0"
    addi x4, x3, 1
    beq x4, x0, chk_brace

    # Exit: a0=1 (PASS for rvemu), a7=93 (exit)
    slit s16, "  li x10, 1"
    swrite x8, s16
    slit s16, "  li x17, 93"
    swrite x8, s16
    slit s16, "  ecall"
    swrite x8, s16
    j next

chk_brace:
    slit s16, "}"
    sbeq s1, s16, emit_brace_close
    j next

emit_brace_close:
    slit s16, "  lw ra, 12(sp)"
    swrite x8, s16
    slit s16, "  addi sp, sp, 16"
    swrite x8, s16
    slit s16, "  ret"
    swrite x8, s16
    j next

emit_x_10:
    slit s16, "  li x10, 10"
    swrite x8, s16
    slit s16, "  sw x10, -4(sp)"
    swrite x8, s16
    j next

emit_y_unknown:
    j next

emit_i_unknown:
    j next

emit_z_unknown:
    j next

next:
    lw x1, 0(x0)
    addi x1, x1, 1
    sw x1, 0(x0)
    j main_loop

done:
    sfclose x8
    li x1, 1
    builtin_out x1
    halt
